# Ollama model to use for extraction
OLLAMA_MODEL="gemma4:e2b"
# Sampling temperature (optional; defaults to 0.1). Lower = more deterministic.
OLLAMA_TEMPERATURE="0.1"
# Langfuse tracing (optional).
# Copy this file to `.env` and fill in your keys to enable tracing.
# Leave unset to run the agent without any tracing.
LANGFUSE_PUBLIC_KEY="pk-lf-..."
LANGFUSE_SECRET_KEY="sk-lf-..."
# Self-hosted (Docker) default is http://localhost:3000; cloud is https://cloud.langfuse.com
LANGFUSE_HOST="http://localhost:3000"
